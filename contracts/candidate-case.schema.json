{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AIALRA-0/agent-human-readable-technical-writing/contracts/candidate-case.schema.json",
  "title": "CandidateAnchorCase",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "task", "source", "semantics", "candidate", "review"],
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_operation", "augmentation", "genre", "audience", "media", "components", "request"],
      "properties": {
        "base_operation": {"enum": ["TRANSFORM", "TRANSLATE", "COMPRESS", "EXPLAIN", "GENERATE", "FORMAT_ONLY"]},
        "augmentation": {"enum": ["NONE", "GLOSS", "EXPLANATORY", "TEACHING", "RESEARCHED"]},
        "genre": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "media": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "request": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_type", "content", "references"],
      "properties": {
        "material_type": {"enum": ["text", "image", "table", "code", "multi_turn"]},
        "content": {"type": ["string", "object"]},
        "references": {"type": "array", "items": {"type": "object"}}
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_atoms", "background_atoms", "inference_atoms", "must_preserve", "must_not_invent"],
      "properties": {
        "source_atoms": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "background_atoms": {"type": "array", "items": {"type": "object"}},
        "inference_atoms": {"type": "array", "items": {"type": "object"}},
        "must_preserve": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "must_not_invent": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "status", "revision", "approved_by_user", "category"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^CANDIDATE-[0-9]{2}$"},
        "status": {"const": "candidate"},
        "revision": {"type": "integer", "minimum": 1},
        "approved_by_user": {"const": false},
        "category": {"enum": ["faithful_transform", "glossed_transform", "explanatory_translation", "teaching_transform", "image_explanation", "table_explanation", "code_explanation", "multi_turn"]}
      }
    },
    "task": {"$ref": "#/$defs/task"},
    "source": {"$ref": "#/$defs/source"},
    "semantics": {
      "allOf": [
        {"$ref": "#/$defs/semantics"},
        {"properties": {
        "source_atoms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "provenance_type", "source_locator", "claim"],
            "properties": {
              "id": {"type": "string", "pattern": "^ATOM-[0-9]{3,}$"},
              "provenance_type": {"enum": ["SOURCE", "USER_SUPPLIED"]},
              "source_locator": {"type": "string", "minLength": 1},
              "claim": {"type": "string", "minLength": 1}
            }
          }
        },
        "background_atoms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "provenance_type", "source_reference", "purpose", "claim"],
            "properties": {
              "id": {"type": "string", "pattern": "^BG-[0-9]{3,}$"},
              "provenance_type": {"const": "EXTERNAL_BACKGROUND"},
              "source_reference": {"type": "string", "minLength": 1},
              "purpose": {"type": "string", "minLength": 1},
              "claim": {"type": "string", "minLength": 1}
            }
          }
        },
        "inference_atoms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "provenance_type", "claim", "supported_by", "confidence"],
            "properties": {
              "id": {"type": "string", "pattern": "^INF-[0-9]{3,}$"},
              "provenance_type": {"const": "INFERENCE"},
              "claim": {"type": "string", "minLength": 1},
              "supported_by": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(ATOM|BG)-[0-9]{3,}$"}},
              "confidence": {"enum": ["low", "medium", "high"]}
            }
          }
        },
        "must_preserve": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "must_not_invent": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }}
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer", "support_map", "self_claims"],
      "properties": {
        "answer": {"type": "string", "minLength": 1},
        "support_map": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "self_claims": {"type": "array", "maxItems": 0}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questions", "privacy"],
      "properties": {
        "questions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "basis"],
          "properties": {
            "status": {"const": "public_safe"},
            "basis": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
