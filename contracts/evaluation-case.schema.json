{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AIALRA-0/agent-human-readable-technical-writing/contracts/evaluation-case.schema.json",
  "title": "EvaluationCaseLifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "task", "source", "semantics", "artifact", "review"],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "origin_case_id", "status", "revision", "approved_by_user", "category", "reviewed_at", "profile_revision_at_review"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^GOLD-[0-9]{2}$|^REJECTED-[0-9]{2}(?:-R[0-9]+)?$|^CANDIDATE-[0-9]{2}-R[0-9]+$"},
        "origin_case_id": {"type": "string", "pattern": "^CANDIDATE-[0-9]{2}$"},
        "status": {"enum": ["gold", "rejected", "candidate"]},
        "revision": {"type": "integer", "minimum": 1},
        "approved_by_user": {"type": "boolean"},
        "category": {"enum": ["faithful_transform", "glossed_transform", "explanatory_translation", "teaching_transform", "image_explanation", "table_explanation", "code_explanation", "multi_turn"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date"},
        "profile_revision_at_review": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "task": {"$ref": "candidate-case.schema.json#/properties/task"},
    "source": {"$ref": "candidate-case.schema.json#/properties/source"},
    "semantics": {"$ref": "candidate-case.schema.json#/properties/semantics"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer", "support_map", "self_claims", "original_case_sha256", "approved_snapshot_sha256"],
      "properties": {
        "answer": {"type": "string", "minLength": 1},
        "support_map": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "self_claims": {"type": "array", "maxItems": 0},
        "original_case_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "approved_snapshot_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_source", "decision", "reasons", "correct_parts", "regression_requirements", "non_blocking_preferences", "privacy"],
      "properties": {
        "decision_source": {"const": "explicit_user_review"},
        "decision": {"enum": ["accepted", "rejected", "pending"]},
        "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "correct_parts": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "regression_requirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "non_blocking_preferences": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "basis"],
          "properties": {
            "status": {"const": "public_safe"},
            "basis": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"identity": {"properties": {"status": {"const": "gold"}}}}},
      "then": {
        "properties": {
          "identity": {"properties": {"case_id": {"pattern": "^GOLD-[0-9]{2}$"}, "approved_by_user": {"const": true}, "reviewed_at": {"type": "string"}, "profile_revision_at_review": {"type": "string"}}},
          "artifact": {"properties": {"approved_snapshot_sha256": {"type": "string"}}},
          "review": {"properties": {"decision": {"const": "accepted"}}}
        }
      }
    },
    {
      "if": {"properties": {"identity": {"properties": {"status": {"const": "rejected"}}}}},
      "then": {
        "properties": {
          "identity": {"properties": {"case_id": {"pattern": "^REJECTED-[0-9]{2}(?:-R[0-9]+)?$"}, "approved_by_user": {"const": false}, "reviewed_at": {"type": "string"}, "profile_revision_at_review": {"type": "string"}}},
          "artifact": {"properties": {"approved_snapshot_sha256": {"type": "null"}}},
          "review": {"properties": {"decision": {"const": "rejected"}, "reasons": {"minItems": 1}, "regression_requirements": {"minItems": 1}}}
        }
      }
    },
    {
      "if": {"properties": {"identity": {"properties": {"status": {"const": "candidate"}}}}},
      "then": {
        "properties": {
          "identity": {"properties": {"case_id": {"pattern": "^CANDIDATE-[0-9]{2}-R[0-9]+$"}, "approved_by_user": {"const": false}, "reviewed_at": {"type": "null"}, "profile_revision_at_review": {"type": "null"}}},
          "artifact": {"properties": {"approved_snapshot_sha256": {"type": "null"}}},
          "review": {"properties": {"decision": {"const": "pending"}}}
        }
      }
    }
  ]
}
