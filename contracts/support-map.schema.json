{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AIALRA-0/agent-human-readable-technical-writing/contracts/support-map.schema.json",
  "title": "SupportMap",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "target", "support", "roles"],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_id"],
      "properties": {"mapping_id": {"type": "string", "pattern": "^MAP-[0-9]{3,}$"}}
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sentence_id", "segment_id"],
      "properties": {
        "sentence_id": {"type": "string", "pattern": "^SENT-[0-9]{3,}$"},
        "segment_id": {"type": "string", "pattern": "^SEG-[0-9]{2,}$"}
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atom_ids"],
      "properties": {"atom_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(ATOM|BG|INF)-[0-9]{3,}$"}}}
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values"],
      "properties": {"values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["source_restatement", "user_requirement", "explanatory_background", "inference", "logical_bridge", "component_explanation", "necessary_transition"]}}}
    }
  }
}
