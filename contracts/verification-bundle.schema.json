{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AIALRA-0/agent-human-readable-technical-writing/contracts/verification-bundle.schema.json",
  "title": "VerificationBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_contract", "iterations", "long_context_coverage", "source_spans", "source_presentations", "source_atoms", "background_atoms", "inference_atoms", "segment_contracts", "support_maps", "term_uses", "parallel_group_coverage", "component_coverage", "boundary_coverage", "rendered_document"],
  "properties": {
    "task_contract": {"$ref": "task-contract.schema.json"},
    "iterations": {"$ref": "closure-run.schema.json"},
    "long_context_coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_char_count", "length_class", "section_count", "full_document_check", "anchors", "term_scopes", "source_priorities"],
      "properties": {
        "input_char_count": {"type": "integer", "minimum": 1},
        "length_class": {"enum": ["very_short", "short", "medium", "long", "extended"]},
        "section_count": {"type": "integer", "minimum": 1},
        "full_document_check": {"type": "boolean"},
        "anchors": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["anchor_id", "kind", "source_locator", "expected_value", "observed_value", "output_locator", "status"],
            "properties": {
              "anchor_id": {"type": "string", "pattern": "^LC-A[0-9]{3,}$"},
              "kind": {"enum": ["CONDITION", "NEGATION", "EXCEPTION", "NUMBER", "RANGE", "CLAIM"]},
              "source_locator": {"type": "string", "minLength": 1},
              "expected_value": {"type": "string", "minLength": 1},
              "observed_value": {"type": ["string", "null"]},
              "output_locator": {"type": ["string", "null"]},
              "status": {"enum": ["preserved", "missing", "changed"]}
            }
          }
        },
        "term_scopes": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["term", "scope_id", "expected_meaning", "observed_meaning", "output_locator"],
            "properties": {
              "term": {"type": "string", "minLength": 1},
              "scope_id": {"type": "string", "pattern": "^LC-SCOPE-[0-9]{3,}$"},
              "expected_meaning": {"type": "string", "minLength": 1},
              "observed_meaning": {"type": "string", "minLength": 1},
              "output_locator": {"type": "string", "minLength": 1}
            }
          }
        },
        "source_priorities": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["conflict_id", "selected_source_id", "surfaced"],
            "properties": {
              "conflict_id": {"type": "string", "pattern": "^LC-CONFLICT-[0-9]{3,}$"},
              "selected_source_id": {"type": "string", "minLength": 1},
              "surfaced": {"type": "boolean"}
            }
          }
        }
      }
    },
    "source_spans": {"type": "array", "items": {"$ref": "source-span.schema.json"}},
    "source_presentations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_span_id", "format", "verbatim", "rendered_excerpt", "reason"],
        "properties": {
          "source_span_id": {"type": "string", "pattern": "^SRC-[0-9]{3,}$"},
          "format": {"enum": ["blockquote", "code_fence", "image", "table", "section"]},
          "verbatim": {"type": "boolean"},
          "rendered_excerpt": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_atoms": {"type": "array", "items": {"$ref": "source-atom.schema.json"}},
    "background_atoms": {"type": "array", "items": {"$ref": "background-atom.schema.json"}},
    "inference_atoms": {"type": "array", "items": {"$ref": "inference-atom.schema.json"}},
    "segment_contracts": {"type": "array", "items": {"$ref": "segment-contract.schema.json"}},
    "support_maps": {"type": "array", "items": {"$ref": "support-map.schema.json"}},
    "term_uses": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["term_id", "official_form", "parenthetical_form", "claimed_expansion", "context", "meanings_covered", "sentence_id"],
        "properties": {
          "term_id": {"type": "string", "minLength": 1},
          "official_form": {"type": "string", "minLength": 1},
          "parenthetical_form": {"type": ["string", "null"]},
          "claimed_expansion": {"type": ["string", "null"]},
          "context": {"enum": ["authored_prose", "code", "inline_code", "url", "path", "verbatim"]},
          "meanings_covered": {"type": "array", "uniqueItems": true, "items": {"enum": ["definition", "current_use", "observable_behavior", "actual_impact", "name_origin"]}},
          "sentence_id": {"type": "string", "pattern": "^SENT-[0-9]{3,}$"}
        }
      }
    },
    "parallel_group_coverage": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["group_id", "item_ids", "covered_item_ids", "rendered_as_list", "nesting_depth"],
        "properties": {
          "group_id": {"type": "string", "pattern": "^PGRP-[0-9]{3,}$"},
          "item_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "covered_item_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "rendered_as_list": {"type": "boolean"},
          "nesting_depth": {"type": "integer", "minimum": 0}
        }
      }
    },
    "component_coverage": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["component_id", "component_type", "source_text", "source_position", "explanation_position", "required_units", "covered_units", "presentation", "mermaid", "table_cells", "code"],
        "properties": {
          "component_id": {"type": "string", "minLength": 1},
          "component_type": {"enum": ["IMAGE", "TABLE", "CODE", "FLOWCHART"]},
          "source_text": {"type": "string", "minLength": 1},
          "source_position": {"type": "integer", "minimum": 0},
          "explanation_position": {"type": "integer", "minimum": 0},
          "required_units": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "covered_units": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "presentation": {
            "type": "object", "additionalProperties": false,
            "required": ["source_format", "object_alignment", "caption_alignment", "renderer", "limitation"],
            "properties": {
              "source_format": {"enum": ["code_fence", "image", "table", "mermaid"]},
              "object_alignment": {"enum": ["center", "renderer_default", "not_applicable"]},
              "caption_alignment": {"enum": ["center", "renderer_default", "not_applicable"]},
              "renderer": {"enum": ["chat", "github_markdown", "html", "word", "pdf", "other"]},
              "limitation": {"type": "string"}
            }
          },
          "mermaid": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["direction", "post_explanation"],
            "properties": {
              "direction": {"enum": ["TD", "TB", "LR", "RL"]},
              "post_explanation": {
                "type": "object", "additionalProperties": false,
                "required": ["node_relationships", "process_result", "evidence_boundary"],
                "properties": {
                  "node_relationships": {"type": "string"},
                  "process_result": {"type": "string"},
                  "evidence_boundary": {"type": "string"}
                }
              }
            }
          },
          "table_cells": {
            "type": "object", "additionalProperties": false,
            "required": ["all", "covered"],
            "properties": {
              "all": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "covered": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          },
          "code": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["coverage_mode", "unit_mappings", "uncovered_units", "comment_alignment"],
            "properties": {
              "coverage_mode": {"enum": ["annotated_code", "line_by_line_explanation"]},
              "unit_mappings": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["unit_id", "source_locator", "explanation_locator"],
                  "properties": {
                    "unit_id": {"type": "string", "pattern": "^CODE-[0-9]{3,}$"},
                    "source_locator": {"type": "string", "minLength": 1},
                    "explanation_locator": {"type": "string", "minLength": 1}
                  }
                }
              },
              "uncovered_units": {"type": "array", "items": {"type": "string", "pattern": "^CODE-[0-9]{3,}$"}},
              "comment_alignment": {
                "type": "object", "additionalProperties": false,
                "required": ["mode", "blocks"],
                "properties": {
                  "mode": {"enum": ["not_applicable", "longest_commentable_line"]},
                  "blocks": {
                    "type": "array",
                    "items": {
                      "type": "object", "additionalProperties": false,
                      "required": ["block_id", "target_column", "units"],
                      "properties": {
                        "block_id": {"type": "string", "pattern": "^CODE-BLOCK-[0-9]{3,}$"},
                        "target_column": {"type": "integer", "minimum": 2},
                        "units": {
                          "type": "array",
                          "items": {
                            "type": "object", "additionalProperties": false,
                            "required": ["unit_id", "commentable", "code_width", "comment_column", "same_line"],
                            "properties": {
                              "unit_id": {"type": "string", "pattern": "^CODE-[0-9]{3,}$"},
                              "commentable": {"type": "boolean"},
                              "code_width": {"type": "integer", "minimum": 0},
                              "comment_column": {"type": ["integer", "null"], "minimum": 2},
                              "same_line": {"type": "boolean"}
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "boundary_coverage": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim_id", "missing_evidence", "importance", "next_verification"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "missing_evidence": {"type": "string", "minLength": 1},
          "importance": {"type": "string", "minLength": 1},
          "next_verification": {"type": "string", "minLength": 1}
        }
      }
    },
    "rendered_document": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "sha256", "sentences"],
      "properties": {
        "text": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sentences": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["sentence_id", "text", "verbatim", "actor_clarity"],
            "properties": {
              "sentence_id": {"type": "string", "pattern": "^SENT-[0-9]{3,}$"},
              "text": {"type": "string"},
              "verbatim": {"type": "boolean"},
              "actor_clarity": {
                "type": "object", "additionalProperties": false,
                "required": ["status", "actor", "basis"],
                "properties": {
                  "status": {"enum": ["explicit", "carried", "not_applicable"]},
                  "actor": {"type": ["string", "null"]},
                  "basis": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    }
  }
}
