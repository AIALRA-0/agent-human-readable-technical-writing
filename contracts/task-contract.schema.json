{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AIALRA-0/agent-human-readable-technical-writing/contracts/task-contract.schema.json",
  "title": "TaskContract",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "operation", "context", "long_context", "terminology", "structure", "components", "code", "conversation", "presentation", "boundaries", "quality", "clarification"],
  "properties": {
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "contract_version", "profile_revision"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^TASK-[A-Z0-9-]+$"},
        "contract_version": {"const": "1.1"},
        "profile_revision": {"const": "round-5-inline-alignment-aemp"}
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["base_operation", "augmentation", "source_coverage_target"],
      "properties": {
        "base_operation": {"enum": ["TRANSFORM", "TRANSLATE", "COMPRESS", "EXPLAIN", "GENERATE", "FORMAT_ONLY"]},
        "augmentation": {"enum": ["NONE", "GLOSS", "EXPLANATORY", "TEACHING", "RESEARCHED"]},
        "source_coverage_target": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["audience", "genre", "media", "components", "user_profile", "reading_context"],
      "properties": {
        "audience": {"type": "string", "minLength": 1},
        "genre": {"type": "string", "minLength": 1},
        "media": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "components": {"type": "array", "uniqueItems": true, "items": {"enum": ["TEXT", "IMAGE", "TABLE", "CODE", "FORMULA", "CITATION", "FLOWCHART"]}},
        "user_profile": {"type": "string", "minLength": 1},
        "reading_context": {"enum": ["standalone", "continuous_document"]}
      }
    },
    "long_context": {
      "type": "object", "additionalProperties": false,
      "required": ["content_task", "input_char_count", "length_class", "section_count", "global_recheck_required", "anchor_requirements", "term_scope_requirements", "source_priority_requirements"],
      "properties": {
        "content_task": {"enum": ["tutorial", "operation", "reference", "explanation", "decision", "status", "audit"]},
        "input_char_count": {"type": "integer", "minimum": 1},
        "length_class": {"enum": ["very_short", "short", "medium", "long", "extended"]},
        "section_count": {"type": "integer", "minimum": 1},
        "global_recheck_required": {"type": "boolean"},
        "anchor_requirements": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["anchor_id", "kind", "source_locator", "expected_value"],
            "properties": {
              "anchor_id": {"type": "string", "pattern": "^LC-A[0-9]{3,}$"},
              "kind": {"enum": ["CONDITION", "NEGATION", "EXCEPTION", "NUMBER", "RANGE", "CLAIM"]},
              "source_locator": {"type": "string", "minLength": 1},
              "expected_value": {"type": "string", "minLength": 1}
            }
          }
        },
        "term_scope_requirements": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["term", "scope_id", "expected_meaning"],
            "properties": {
              "term": {"type": "string", "minLength": 1},
              "scope_id": {"type": "string", "pattern": "^LC-SCOPE-[0-9]{3,}$"},
              "expected_meaning": {"type": "string", "minLength": 1}
            }
          }
        },
        "source_priority_requirements": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["conflict_id", "claim", "source_ids", "priority_source_id", "must_surface"],
            "properties": {
              "conflict_id": {"type": "string", "pattern": "^LC-CONFLICT-[0-9]{3,}$"},
              "claim": {"type": "string", "minLength": 1},
              "source_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "priority_source_id": {"type": "string", "minLength": 1},
              "must_surface": {"type": "boolean"}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"length_class": {"enum": ["long", "extended"]}}},
          "then": {"properties": {"global_recheck_required": {"const": true}, "anchor_requirements": {"minItems": 1}}}
        }
      ]
    },
    "terminology": {
      "type": "object", "additionalProperties": false,
      "required": ["known_terms", "term_requirements"],
      "properties": {
        "known_terms": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "term_requirements": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["term_id", "official_form", "official_english", "abbreviation", "registered", "official_case_verified", "name_rationale", "name_rationale_source", "parenthetical_english_case", "parenthetical_form", "official_case_precedence", "acronym_expansion_allowed", "required_meanings"],
            "properties": {
              "term_id": {"type": "string", "minLength": 1},
              "official_form": {"type": "string", "minLength": 1},
              "official_english": {"type": ["string", "null"], "minLength": 1},
              "abbreviation": {"type": ["string", "null"], "minLength": 1},
              "registered": {"type": "boolean"},
              "official_case_verified": {"type": "boolean"},
              "name_rationale": {"type": "string", "minLength": 1},
              "name_rationale_source": {"type": "string", "minLength": 1},
              "parenthetical_english_case": {"enum": ["title_case", "official", "not_applicable"]},
              "parenthetical_form": {"type": ["string", "null"]},
              "official_case_precedence": {"const": true},
              "acronym_expansion_allowed": {"type": "boolean"},
              "required_meanings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["definition", "current_use", "observable_behavior", "actual_impact", "name_origin"]}}
            }
          }
        }
      }
    },
    "structure": {
      "type": "object", "additionalProperties": false,
      "required": ["parallel_groups"],
      "properties": {
        "parallel_groups": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["group_id", "kind", "item_ids", "required_layout", "minimum_depth"],
            "properties": {
              "group_id": {"type": "string", "pattern": "^PGRP-[0-9]{3,}$"},
              "kind": {"enum": ["definition", "procedure", "comparison", "facts", "causes", "actions"]},
              "item_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "required_layout": {"const": "indented_list"},
              "minimum_depth": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "components": {
      "type": "object", "additionalProperties": false,
      "required": ["component_order", "layout_exceptions"],
      "properties": {
        "component_order": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["component_id", "source_before_explanation"],
            "properties": {
              "component_id": {"type": "string", "minLength": 1},
              "source_before_explanation": {"type": "boolean"}
            }
          }
        },
        "layout_exceptions": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["component_id", "requested_layout", "reason", "why_vertical_is_not_viable"],
            "properties": {
              "component_id": {"type": "string", "minLength": 1},
              "requested_layout": {"enum": ["LR", "RL"]},
              "reason": {"type": "string", "minLength": 1},
              "why_vertical_is_not_viable": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "code": {
      "type": "object", "additionalProperties": false,
      "required": ["coverage_mode", "unit_mappings", "comment_alignment"],
      "properties": {
        "coverage_mode": {"enum": ["not_applicable", "annotated_code", "line_by_line_explanation"]},
        "unit_mappings": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["unit_id", "source_locator", "explanation_locator"],
            "properties": {
              "unit_id": {"type": "string", "pattern": "^CODE-[0-9]{3,}$"},
              "source_locator": {"type": "string", "minLength": 1},
              "explanation_locator": {"type": "string", "minLength": 1}
            }
          }
        },
        "comment_alignment": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "scope", "overflow_policy"],
          "properties": {
            "mode": {"enum": ["not_applicable", "longest_commentable_line"]},
            "scope": {"const": "per_code_block"},
            "overflow_policy": {"const": "allow"}
          }
        }
      }
    },
    "conversation": {
      "type": "object", "additionalProperties": false,
      "required": ["preserve_superseded_requirements", "superseded_texts", "reason"],
      "properties": {
        "preserve_superseded_requirements": {"type": "boolean"},
        "superseded_texts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "presentation": {
      "type": "object", "additionalProperties": false,
      "required": ["renderer", "source_material", "component_alignment", "render_evidence"],
      "properties": {
        "renderer": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "exact_object_alignment", "exact_caption_alignment"],
          "properties": {
            "name": {"enum": ["chat", "github_markdown", "html", "word", "pdf", "other"]},
            "exact_object_alignment": {"type": "boolean"},
            "exact_caption_alignment": {"type": "boolean"}
          }
        },
        "source_material": {
          "type": "object", "additionalProperties": false,
          "required": ["required", "format", "reason"],
          "properties": {
            "required": {"type": "boolean"},
            "format": {"enum": ["none", "blockquote", "code_fence", "image", "table", "section"]},
            "reason": {"type": "string"}
          }
        },
        "component_alignment": {
          "type": "object", "additionalProperties": false,
          "required": ["object", "caption", "fallback"],
          "properties": {
            "object": {"enum": ["center", "renderer_default", "not_applicable"]},
            "caption": {"enum": ["center", "renderer_default", "not_applicable"]},
            "fallback": {"type": "string"}
          }
        },
        "render_evidence": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["component_id", "renderer", "viewport_width", "theme", "object_centered", "caption_centered", "horizontal_overflow", "evidence_source"],
            "properties": {
              "component_id": {"type": "string", "minLength": 1},
              "renderer": {"const": "github_markdown"},
              "viewport_width": {"enum": [390, 1280]},
              "theme": {"enum": ["light", "dark"]},
              "object_centered": {"type": "boolean"},
              "caption_centered": {"type": "boolean"},
              "horizontal_overflow": {"type": "boolean"},
              "evidence_source": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "boundaries": {
      "type": "object", "additionalProperties": false,
      "required": ["boundary_requirements"],
      "properties": {
        "boundary_requirements": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["claim_id", "missing_evidence", "importance", "next_verification"],
            "properties": {
              "claim_id": {"type": "string", "minLength": 1},
              "missing_evidence": {"type": "string", "minLength": 1},
              "importance": {"type": "string", "minLength": 1},
              "next_verification": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "quality": {
      "type": "object", "additionalProperties": false,
      "required": ["provenance_required", "protected_categories", "rule_levels", "inline_code_tokens"],
      "properties": {
        "provenance_required": {"type": "boolean"},
        "protected_categories": {"type": "array", "uniqueItems": true, "items": {"enum": ["NUMBER", "DATE", "VERSION", "PATH", "CODE_IDENTIFIER", "NEGATION", "CONDITION", "SCOPE", "MODALITY"]}},
        "rule_levels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["MACHINE_FINAL", "MACHINE_CANDIDATE", "PROFILE_REQUIRED", "ADVISORY"]}},
        "inline_code_tokens": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "clarification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "blocking_questions"],
      "properties": {
        "status": {"enum": ["CLEAR", "BLOCKED"]},
        "blocking_questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"context": {"properties": {"reading_context": {"const": "standalone"}}}}},
      "then": {"properties": {"terminology": {"properties": {"known_terms": {"maxItems": 0}}}}}
    }
  ]
}
