{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AIALRA-0/agent-human-readable-technical-writing/contracts/inference-atom.schema.json",
  "title": "InferenceAtom",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "provenance", "claim", "support", "epistemic"],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atom_id"],
      "properties": {"atom_id": {"type": "string", "pattern": "^INF-[0-9]{3,}$"}}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenance_type"],
      "properties": {"provenance_type": {"const": "INFERENCE"}}
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {"text": {"type": "string", "minLength": 1}}
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported_by"],
      "properties": {"supported_by": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(ATOM|BG)-[0-9]{3,}$"}}}
    },
    "epistemic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "must_not_upgrade_to_fact"],
      "properties": {
        "confidence": {"enum": ["low", "medium", "high"]},
        "must_not_upgrade_to_fact": {"const": true}
      }
    }
  }
}
