{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AIALRA-0/agent-human-readable-technical-writing/contracts/background-atom.schema.json",
  "title": "BackgroundAtom",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "provenance", "content", "usage_limits"],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atom_id"],
      "properties": {"atom_id": {"type": "string", "pattern": "^BG-[0-9]{3,}$"}}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenance_type", "source_reference"],
      "properties": {
        "provenance_type": {"const": "EXTERNAL_BACKGROUND"},
        "source_reference": {"type": "string", "minLength": 1}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "claim"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1}
      }
    },
    "usage_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_not_present_as_source", "allowed_segments"],
      "properties": {
        "must_not_present_as_source": {"const": true},
        "allowed_segments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SEG-[0-9]{2,}$"}}
      }
    }
  }
}
