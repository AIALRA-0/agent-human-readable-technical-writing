{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AIALRA-0/agent-human-readable-technical-writing/contracts/task-contract.schema.json",
  "title": "TaskContract",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "operation", "context", "terminology", "components", "presentation", "boundaries", "quality", "clarification"],
  "properties": {
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "contract_version", "profile_revision"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^TASK-[A-Z0-9-]+$"},
        "contract_version": {"const": "1.1"},
        "profile_revision": {"const": "round-3-capitalization"}
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["base_operation", "augmentation", "source_coverage_target"],
      "properties": {
        "base_operation": {"enum": ["TRANSFORM", "TRANSLATE", "COMPRESS", "EXPLAIN", "GENERATE", "FORMAT_ONLY"]},
        "augmentation": {"enum": ["NONE", "GLOSS", "EXPLANATORY", "TEACHING", "RESEARCHED"]},
        "source_coverage_target": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["audience", "genre", "media", "components", "user_profile", "reading_context"],
      "properties": {
        "audience": {"type": "string", "minLength": 1},
        "genre": {"type": "string", "minLength": 1},
        "media": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "components": {"type": "array", "uniqueItems": true, "items": {"enum": ["TEXT", "IMAGE", "TABLE", "CODE", "FORMULA", "CITATION", "FLOWCHART"]}},
        "user_profile": {"type": "string", "minLength": 1},
        "reading_context": {"enum": ["standalone", "continuous_document"]}
      }
    },
    "terminology": {
      "type": "object", "additionalProperties": false,
      "required": ["known_terms", "term_requirements"],
      "properties": {
        "known_terms": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "term_requirements": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["term_id", "official_form", "registered", "official_case_verified", "parenthetical_english_case", "parenthetical_form", "official_case_precedence", "acronym_expansion_allowed", "required_meanings"],
            "properties": {
              "term_id": {"type": "string", "minLength": 1},
              "official_form": {"type": "string", "minLength": 1},
              "registered": {"type": "boolean"},
              "official_case_verified": {"type": "boolean"},
              "parenthetical_english_case": {"enum": ["title_case", "official", "not_applicable"]},
              "parenthetical_form": {"type": ["string", "null"]},
              "official_case_precedence": {"const": true},
              "acronym_expansion_allowed": {"type": "boolean"},
              "required_meanings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["definition", "current_use", "observable_behavior", "actual_impact", "name_origin"]}}
            }
          }
        }
      }
    },
    "components": {
      "type": "object", "additionalProperties": false,
      "required": ["component_order", "layout_exceptions"],
      "properties": {
        "component_order": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["component_id", "source_before_explanation"],
            "properties": {
              "component_id": {"type": "string", "minLength": 1},
              "source_before_explanation": {"type": "boolean"}
            }
          }
        },
        "layout_exceptions": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["component_id", "requested_layout", "reason", "why_vertical_is_not_viable"],
            "properties": {
              "component_id": {"type": "string", "minLength": 1},
              "requested_layout": {"enum": ["LR", "RL"]},
              "reason": {"type": "string", "minLength": 1},
              "why_vertical_is_not_viable": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "presentation": {
      "type": "object", "additionalProperties": false,
      "required": ["renderer", "source_material", "component_alignment"],
      "properties": {
        "renderer": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "exact_object_alignment", "exact_caption_alignment"],
          "properties": {
            "name": {"enum": ["chat", "github_markdown", "html", "word", "pdf", "other"]},
            "exact_object_alignment": {"type": "boolean"},
            "exact_caption_alignment": {"type": "boolean"}
          }
        },
        "source_material": {
          "type": "object", "additionalProperties": false,
          "required": ["required", "format", "reason"],
          "properties": {
            "required": {"type": "boolean"},
            "format": {"enum": ["none", "blockquote", "code_fence", "image", "table", "section"]},
            "reason": {"type": "string"}
          }
        },
        "component_alignment": {
          "type": "object", "additionalProperties": false,
          "required": ["object", "caption", "fallback"],
          "properties": {
            "object": {"enum": ["center", "renderer_default", "not_applicable"]},
            "caption": {"enum": ["center", "renderer_default", "not_applicable"]},
            "fallback": {"type": "string"}
          }
        }
      }
    },
    "boundaries": {
      "type": "object", "additionalProperties": false,
      "required": ["boundary_requirements"],
      "properties": {
        "boundary_requirements": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["claim_id", "missing_evidence", "importance", "next_verification"],
            "properties": {
              "claim_id": {"type": "string", "minLength": 1},
              "missing_evidence": {"type": "string", "minLength": 1},
              "importance": {"type": "string", "minLength": 1},
              "next_verification": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "quality": {
      "type": "object", "additionalProperties": false,
      "required": ["provenance_required", "protected_categories", "rule_levels", "inline_code_tokens"],
      "properties": {
        "provenance_required": {"type": "boolean"},
        "protected_categories": {"type": "array", "uniqueItems": true, "items": {"enum": ["NUMBER", "DATE", "VERSION", "PATH", "CODE_IDENTIFIER", "NEGATION", "CONDITION", "SCOPE", "MODALITY"]}},
        "rule_levels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["MACHINE_FINAL", "MACHINE_CANDIDATE", "PROFILE_REQUIRED", "ADVISORY"]}},
        "inline_code_tokens": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "clarification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "blocking_questions"],
      "properties": {
        "status": {"enum": ["CLEAR", "BLOCKED"]},
        "blocking_questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"context": {"properties": {"reading_context": {"const": "standalone"}}}}},
      "then": {"properties": {"terminology": {"properties": {"known_terms": {"maxItems": 0}}}}}
    }
  ]
}
