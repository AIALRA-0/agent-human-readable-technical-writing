{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AIALRA-0/agent-human-readable-technical-writing/contracts/forward-manifest-output.schema.json",
  "title": "ForwardManifestOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_units", "support_map", "background_claims", "term_uses", "parallel_groups", "section_plan", "boundary_visibility"],
  "properties": {
    "source_units": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SRCU-[0-9]{3}$"}},
    "support_map": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SRCU-[0-9]{3}$"}},
    "background_claims": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim", "source_reference"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "source_reference": {"type": "string", "minLength": 1}
        }
      }
    },
    "term_uses": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["term", "official_english", "first_use_text"],
        "properties": {
          "term": {"type": "string", "minLength": 1},
          "official_english": {"type": ["string", "null"]},
          "first_use_text": {"type": "string", "minLength": 1}
        }
      }
    },
    "parallel_groups": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["group_id", "item_texts", "required_layout", "rendered_as_indented_list"],
        "properties": {
          "group_id": {"type": "string", "pattern": "^PGRP-[0-9]{3,}$"},
          "item_texts": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$"}},
          "required_layout": {"enum": ["compact_inline", "indented_list"]},
          "rendered_as_indented_list": {"type": "boolean"}
        }
      }
    },
    "section_plan": {
      "type": "object", "additionalProperties": false,
      "required": ["headings_required", "heading_levels", "basis", "colon_pseudo_headings_allowed"],
      "properties": {
        "headings_required": {"type": "boolean"},
        "heading_levels": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 6}},
        "basis": {"type": "string", "minLength": 1},
        "colon_pseudo_headings_allowed": {"type": "boolean", "const": false}
      }
    },
    "boundary_visibility": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "material_reason"],
      "properties": {
        "mode": {"enum": ["internal", "natural_when_material"]},
        "material_reason": {"type": ["string", "null"]}
      }
    }
  }
}
